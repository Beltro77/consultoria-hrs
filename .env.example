# Copia este archivo a .env.local y reemplaza con tus datos de Supabase
NEXT_PUBLIC_SUPABASE_URL=https://xxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJ...

# Service role key de Supabase (Settings → API → service_role, secreta).
# La usa /api/notify-lead para leer las suscripciones push sin pasar por RLS.
SUPABASE_SERVICE_ROLE_KEY=

# Web Push: aviso push al consultor cuando entra un lead nuevo desde /intake.
# Generadas con `npx web-push generate-vapid-keys` (no hace falta cuenta externa).
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
